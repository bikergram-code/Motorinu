/// ✅ Carbon Fiber Pattern Painter
class _CarbonFiberPainter extends CustomPainter {
  final Color base;
  final Color lineA;
  final Color lineB;

  _CarbonFiberPainter({
    required this.base,
    required this.lineA,
    required this.lineB,
  });

  @override
  void paint(Canvas canvas, Size size) {
    canvas.drawRect(Offset.zero & size, Paint()..color = base);

    const double tile = 18.0;
    final paintA = Paint()..color = lineA..strokeWidth = 1.0;
    final paintB = Paint()..color = lineB..strokeWidth = 1.0;

    for (double x = -size.height; x < size.width; x += tile) {
      canvas.drawLine(Offset(x, 0), Offset(x + size.height, size.height), paintA);
    }
    for (double x = 0; x < size.width + size.height; x += tile) {
      canvas.drawLine(Offset(x, 0), Offset(x - size.height, size.height), paintB);
    }

    final weavePaint = Paint()..color = Colors.black.withOpacity(0.06);
    for (double y = 0; y < size.height; y += tile) {
      for (double x = 0; x < size.width; x += tile) {
        if (((x / tile).floor() + (y / tile).floor()) % 2 == 0) {
          canvas.drawRect(Rect.fromLTWH(x, y, tile, tile), weavePaint);
        }
      }
    }

    final noisePaint = Paint()..color = Colors.black.withOpacity(0.02);
    for (double y = 0; y < size.height; y += 6) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), noisePaint);
    }
  }

  @override
  bool shouldRepaint(covariant _CarbonFiberPainter oldDelegate) {
    return oldDelegate.base != base ||
        oldDelegate.lineA != lineA ||
        oldDelegate.lineB != lineB;
  }
}

/// 🏍️ Loader (Stateful, eigener Controller -> garantiert nicht starr)
class _BikerRoadLoader extends StatefulWidget {
  const _BikerRoadLoader();

  @override
  State<_BikerRoadLoader> createState() => _BikerRoadLoaderState();
}

class _BikerRoadLoaderState extends State<_BikerRoadLoader>
    with SingleTickerProviderStateMixin {
  late final AnimationController _ctrl;

  @override
  void initState() {
    super.initState();
    _ctrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1200),
    )..repeat();
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return AnimatedBuilder(
      animation: _ctrl,
      builder: (context, _) {
        final t = _ctrl.value;

        return Container(
          decoration: BoxDecoration(
            color: theme.colorScheme.surface, // ✅ deckend
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: Colors.black.withOpacity(0.22), width: 2),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withOpacity(0.18),
                blurRadius: 18,
                offset: const Offset(0, 12),
              ),
            ],
          ),
          child: Stack(
            children: [
              Positioned.fill(
                child: CustomPaint(
                  painter: _RoadPainter(offset: t * 30),
                ),
              ),
              LayoutBuilder(
                builder: (context, c) {
                  // ✅ Moped fährt von links (leicht außerhalb) nach rechts (leicht außerhalb)
                  // + kleiner „Bob“ für Leben.
                  final ease = Curves.easeInOut.transform(t);
                  final startX = -36.0;
                  final endX = c.maxWidth + 8.0;
                  final x = startX + (endX - startX) * ease;

                  final bob = math.sin(t * math.pi * 2) * 1.6;
                  final tilt = math.sin(t * math.pi * 2) * 0.06;
                  return Positioned(
                    left: x,
                    top: (c.maxHeight - 28) / 2 + bob,
                    child: Transform.rotate(
                      angle: tilt,
                      child: Icon(
                        Icons.two_wheeler_rounded,
                        size: 28,
                        color: theme.colorScheme.secondary,
                      ),
                    ),
                  );
                },
              ),
            ],
          ),
        );
      },
    );
  }
}

class _RoadPainter extends CustomPainter {
  final double offset;
  _RoadPainter({required this.offset});

  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.black.withOpacity(0.32)
      ..strokeWidth = 2
      ..strokeCap = StrokeCap.round;

    const dash = 12.0;
    const gap = 10.0;
    final y = size.height / 2;

    double x = -(offset % (dash + gap));
    while (x < size.width) {
      canvas.drawLine(Offset(x, y), Offset(x + dash, y), paint);
      x += dash + gap;
    }
  }

  @override
  bool shouldRepaint(covariant _RoadPainter oldDelegate) =>
      oldDelegate.offset != offset;
}
