<?xml version="1.0" encoding="utf-8"?>
<!--
  Motorinu Network Security Config
  - Default: HTTPS-only (Play Store compliant)
  - Cleartext erlaubt nur fuer eigenen OSRM-Server (152.53.255.4:8080)
    Grund: Interne Routing-API, laeuft noch ohne TLS-Zertifikat.
    TODO: osrm.bikergram.com mit Let's Encrypt aufsetzen und diese Ausnahme entfernen.
-->
<network-security-config>
    <!-- Global: Kein Cleartext erlaubt -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Ausnahme: OSRM Motorcycle Routing Server -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">152.53.255.4</domain>
        <domain includeSubdomains="true">osrm.bikergram.com</domain>
    </domain-config>

    <!-- Debug Builds: Lokales Entwickeln erlauben -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
